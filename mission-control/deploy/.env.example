# Copia este archivo a .env y llena los valores. NUNCA lo subas a git.
# Genera el secret con: openssl rand -base64 48
SESSION_SECRET=
# PAT de Airtable: https://airtable.com/create/tokens
# scopes: data.records:read + data.records:write, base "Punch! Clientes y más"
AIRTABLE_TOKEN=
# PAT de Asana: app.asana.com → Settings → Apps → Developer apps → Personal access token
ASANA_TOKEN=
# API key de Claude para PUNCHI: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
